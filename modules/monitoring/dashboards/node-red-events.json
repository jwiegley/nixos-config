          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  msgid,\n  min(ts) AS started,\n  count(*) AS rows,\n  string_agg(DISTINCT topic, ', ' ORDER BY topic) FILTER (WHERE topic IS NOT NULL) AS topics,\n  string_agg(DISTINCT node_name, ' → ' ORDER BY node_name) AS nodes\nFROM msg_events\nWHERE msgid IS NOT NULL AND $__timeFilter(ts)\nGROUP BY msgid\nORDER BY started DESC\nLIMIT 30",
