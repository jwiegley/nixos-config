#!/run/current-system/sw/bin/bash
# openclaw-self-heal action: re-stage SOPS secrets for the microVM and
# restart the microvm so its preStart re-runs (which re-injects mcporter
# entries from the freshly staged secrets).
#
# Used when an integration that depends on a staged secret (e.g.
# Home Assistant via openclaw/home-assistant-token) is failing.  This is
# strictly more invasive than restart_microvm — it also restarts the
# host-side openclaw-prepare-secrets unit beforehand.
#
# Output: one line of JSON to stdout describing the result.
set -euo pipefail
start_ts=$(date +%s)
rc=0
/run/current-system/sw/bin/systemctl restart openclaw-prepare-secrets.service || rc=$?
if [ "$rc" -eq 0 ]; then
  /run/current-system/sw/bin/systemctl restart microvm@openclaw.service || rc=$?
fi
end_ts=$(date +%s)
duration=$((end_ts - start_ts))
if [ "$rc" -eq 0 ]; then
  printf '{"ok": true, "duration_s": %d, "notes": "secrets restaged and microvm restarted"}\n' "$duration"
else
  printf '{"ok": false, "duration_s": %d, "notes": "restage failed rc=%d"}\n' "$duration" "$rc"
fi
