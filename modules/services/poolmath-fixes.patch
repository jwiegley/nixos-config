diff --git a/custom_components/poolmath/sensor.py b/custom_components/poolmath/sensor.py
index f5d79bf..0f46c65 100644
--- a/custom_components/poolmath/sensor.py
+++ b/custom_components/poolmath/sensor.py
@@ -313,6 +313,16 @@ class PoolMathSensor(CoordinatorEntity[PoolMathUpdateCoordinator], SensorEntity)
         self._attr_native_value: float | None = None
         self._attr_extra_state_attributes: dict[str, Any] = {}
 
+    async def async_added_to_hass(self) -> None:
+        """Seed state from already-fetched coordinator data on add.
+
+        poolmath only updates _attr_native_value in _handle_coordinator_update,
+        which the coordinator first fires one update_interval AFTER setup; without
+        this, every entity reads 'unknown' for ~8 min after each (re)start.
+        """
+        await super().async_added_to_hass()
+        self._handle_coordinator_update()
+
     @callback
     def _handle_coordinator_update(self) -> None:
         """Handle updated data from the coordinator."""
