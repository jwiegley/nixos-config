#!/run/current-system/sw/bin/bash
# openclaw-self-heal action: restart the host-side openclaw-mcporter-check
# service so it re-runs and refreshes openclaw_mcporter_*.prom.
#
# Used when OpenClawMcporterCheckStale fires — the check is a host
# timer-driven unit, NOT something inside the VM, so restart_microvm is
# the wrong action.
#
# Output: one line of JSON to stdout describing the result.
set -euo pipefail
start_ts=$(date +%s)
rc=0
/run/current-system/sw/bin/systemctl restart openclaw-mcporter-check.service || rc=$?
end_ts=$(date +%s)
duration=$((end_ts - start_ts))
if [ "$rc" -eq 0 ]; then
  printf '{"ok": true, "duration_s": %d, "notes": "openclaw-mcporter-check.service restarted"}\n' "$duration"
else
  printf '{"ok": false, "duration_s": %d, "notes": "restart failed rc=%d"}\n' "$duration" "$rc"
fi
